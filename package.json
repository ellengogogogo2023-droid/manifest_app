{
  "name": "meditation-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently --kill-others --names API,EXPO \"npm:backend:dev\" \"npm:start\"",
    "start": "expo start",
    "backend:dev": "npm --prefix backend run dev",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^57.0.10",
    "expo-av": "~14.0.0",
    "expo-constants": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.0",
    "typescript": "~5.4.5"
  }
}
